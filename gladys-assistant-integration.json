{
  "manifest_version": 1,
  "type": "device",
  "name": "DLNA",
  "description": {
    "en": "Control DLNA/UPnP renderers (TV, amp, speaker) and play your media servers, 100% local.",
    "fr": "Pilotez vos lecteurs DLNA/UPnP (TV, ampli, enceinte) et vos serveurs multimédias, 100 % local."
  },
  "version": "1.0.4",
  "docker_image": "ghcr.io/guim31/gladys-dlna:1.0.4",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-dlna/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["local"],
  "network_discovery": [{ "type": "ssdp", "st": "upnp:rootdevice" }],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "Finding your devices", "fr": "Trouver vos appareils" },
      "description": {
        "en": "Renderers and media servers of your network are found automatically: open the Discovery tab and add the ones you want. A device on another network (VLAN, other subnet) can be added by the URL of its UPnP description below.",
        "fr": "Les lecteurs et serveurs multimédias de votre réseau sont trouvés automatiquement : ouvrez l'onglet Découverte et ajoutez ceux que vous voulez. Un appareil d'un autre réseau (VLAN, autre sous-réseau) s'ajoute ci-dessous par l'URL de sa description UPnP."
      }
    },
    {
      "key": "description_urls",
      "type": "string",
      "label": { "en": "Description URLs (optional)", "fr": "URL de description (facultatif)" },
      "description": {
        "en": "One or several UPnP description URLs, separated by commas. Use the action below to test one first.",
        "fr": "Une ou plusieurs URL de description UPnP, séparées par des virgules. Testez-en une d'abord avec l'action ci-dessous."
      },
      "placeholder": {
        "en": "http://192.168.1.20:8200/rootDesc.xml",
        "fr": "http://192.168.1.20:8200/rootDesc.xml"
      },
      "required": false
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités"
      },
      "description": {
        "en": "Used for the devices added from now on: Gladys keeps the names of a device once added.",
        "fr": "Utilisée pour les appareils ajoutés désormais : Gladys garde les noms d'un appareil une fois ajouté."
      },
      "required": false,
      "default": "en",
      "options": [
        { "value": "en", "label": { "en": "English", "fr": "Anglais" } },
        { "value": "fr", "label": { "en": "French", "fr": "Français" } }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_description_url",
      "label": { "en": "Test a description URL", "fr": "Tester une URL de description" },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "url",
          "type": "string",
          "label": { "en": "Description URL", "fr": "URL de description" },
          "placeholder": {
            "en": "http://192.168.1.20:60006/upnp/desc/aios_device/aios_device.xml",
            "fr": "http://192.168.1.20:60006/upnp/desc/aios_device/aios_device.xml"
          },
          "required": true
        }
      ]
    },
    {
      "key": "browse_server",
      "label": { "en": "Browse a media server", "fr": "Parcourir un serveur multimédia" },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "server",
          "type": "select",
          "source": "devices",
          "label": { "en": "Media server", "fr": "Serveur multimédia" },
          "required": true
        },
        {
          "key": "path",
          "type": "string",
          "label": { "en": "Folder (empty: the root)", "fr": "Dossier (vide : la racine)" },
          "placeholder": { "en": "Music/Albums", "fr": "Musique/Albums" },
          "required": false
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "playback_started",
      "label": { "en": "DLNA playback started", "fr": "Lecture DLNA démarrée" },
      "description": {
        "en": "A DLNA renderer started or resumed playing.",
        "fr": "Un lecteur DLNA a démarré ou repris la lecture."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Renderer (empty: any)", "fr": "Lecteur (vide : n'importe lequel)" }
        }
      ],
      "variables": [
        { "key": "renderer", "type": "string", "label": { "en": "Renderer", "fr": "Lecteur" } },
        { "key": "title", "type": "string", "label": { "en": "Title", "fr": "Titre" } },
        { "key": "artist", "type": "string", "label": { "en": "Artist", "fr": "Artiste" } },
        { "key": "album", "type": "string", "label": { "en": "Album", "fr": "Album" } }
      ]
    },
    {
      "key": "playback_paused",
      "label": { "en": "DLNA playback paused", "fr": "Lecture DLNA en pause" },
      "description": {
        "en": "A DLNA renderer paused its playback.",
        "fr": "Un lecteur DLNA a mis sa lecture en pause."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Renderer (empty: any)", "fr": "Lecteur (vide : n'importe lequel)" }
        }
      ],
      "variables": [
        { "key": "renderer", "type": "string", "label": { "en": "Renderer", "fr": "Lecteur" } },
        { "key": "title", "type": "string", "label": { "en": "Title", "fr": "Titre" } },
        { "key": "artist", "type": "string", "label": { "en": "Artist", "fr": "Artiste" } },
        { "key": "album", "type": "string", "label": { "en": "Album", "fr": "Album" } }
      ]
    },
    {
      "key": "playback_stopped",
      "label": { "en": "DLNA playback stopped", "fr": "Lecture DLNA arrêtée" },
      "description": {
        "en": "A DLNA renderer stopped playing (end of the media, or stop).",
        "fr": "Un lecteur DLNA a arrêté la lecture (fin du média, ou arrêt)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Renderer (empty: any)", "fr": "Lecteur (vide : n'importe lequel)" }
        }
      ],
      "variables": [
        { "key": "renderer", "type": "string", "label": { "en": "Renderer", "fr": "Lecteur" } },
        { "key": "title", "type": "string", "label": { "en": "Title", "fr": "Titre" } },
        { "key": "artist", "type": "string", "label": { "en": "Artist", "fr": "Artiste" } },
        { "key": "album", "type": "string", "label": { "en": "Album", "fr": "Album" } }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "play_media",
      "label": {
        "en": "Play a media server on a DLNA renderer",
        "fr": "Lire un serveur multimédia sur un lecteur DLNA"
      },
      "description": {
        "en": "Search a title, an artist, an album or a folder on a media server and play it.",
        "fr": "Cherche un titre, un artiste, un album ou un dossier sur un serveur et le lit."
      },
      "timeout_seconds": 90,
      "fields": [
        {
          "key": "renderer",
          "type": "select",
          "source": "devices",
          "label": { "en": "Renderer", "fr": "Lecteur" },
          "required": true
        },
        {
          "key": "server",
          "type": "select",
          "source": "devices",
          "label": { "en": "Media server", "fr": "Serveur multimédia" },
          "required": true
        },
        {
          "key": "search_by",
          "type": "select",
          "label": { "en": "Search by", "fr": "Chercher par" },
          "default": "any",
          "options": [
            { "value": "any", "label": { "en": "Anything", "fr": "Tout" } },
            { "value": "title", "label": { "en": "Title", "fr": "Titre" } },
            { "value": "artist", "label": { "en": "Artist", "fr": "Artiste" } },
            { "value": "album", "label": { "en": "Album", "fr": "Album" } },
            {
              "value": "folder",
              "label": { "en": "Folder (name or path)", "fr": "Dossier (nom ou chemin)" }
            }
          ]
        },
        {
          "key": "query",
          "type": "string",
          "label": { "en": "Search", "fr": "Recherche" },
          "placeholder": { "en": "Abbey Road, or Music/Jazz", "fr": "Abbey Road, ou Musique/Jazz" },
          "required": true
        },
        {
          "key": "mode",
          "type": "select",
          "label": { "en": "Play", "fr": "Lecture" },
          "default": "all",
          "options": [
            {
              "value": "all",
              "label": { "en": "Everything found, in order", "fr": "Tout, dans l'ordre" }
            },
            {
              "value": "shuffle",
              "label": { "en": "Everything found, shuffled", "fr": "Tout, en aléatoire" }
            },
            {
              "value": "first",
              "label": { "en": "The first result only", "fr": "Le premier résultat seulement" }
            }
          ]
        },
        {
          "key": "volume",
          "type": "number",
          "label": { "en": "Volume (optional, 0-100)", "fr": "Volume (facultatif, 0-100)" },
          "min": 0,
          "max": 100
        }
      ],
      "outputs": [
        {
          "key": "found",
          "type": "boolean",
          "label": { "en": "Something found", "fr": "Résultat trouvé" }
        },
        {
          "key": "count",
          "type": "number",
          "label": { "en": "Tracks queued", "fr": "Pistes en file" }
        },
        {
          "key": "title",
          "type": "string",
          "label": { "en": "First title", "fr": "Premier titre" }
        }
      ]
    },
    {
      "key": "play_url",
      "label": { "en": "Play a URL on a DLNA renderer", "fr": "Lire une URL sur un lecteur DLNA" },
      "description": {
        "en": "A web radio, a sound or an announcement file, by its http(s) URL.",
        "fr": "Une radio web, un son ou un fichier d'annonce, par son URL http(s)."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "renderer",
          "type": "select",
          "source": "devices",
          "label": { "en": "Renderer", "fr": "Lecteur" },
          "required": true
        },
        {
          "key": "url",
          "type": "string",
          "label": { "en": "URL", "fr": "URL" },
          "placeholder": {
            "en": "https://icecast.radiofrance.fr/fip-hifi.aac",
            "fr": "https://icecast.radiofrance.fr/fip-hifi.aac"
          },
          "required": true
        },
        {
          "key": "title",
          "type": "string",
          "label": { "en": "Title shown (optional)", "fr": "Titre affiché (facultatif)" },
          "placeholder": { "en": "FIP", "fr": "FIP" }
        },
        {
          "key": "volume",
          "type": "number",
          "label": { "en": "Volume (optional, 0-100)", "fr": "Volume (facultatif, 0-100)" },
          "min": 0,
          "max": 100
        }
      ],
      "outputs": [
        { "key": "started", "type": "boolean", "label": { "en": "Started", "fr": "Démarrée" } }
      ]
    }
  ],
  "widgets": [
    {
      "key": "player",
      "label": { "en": "DLNA player", "fr": "Lecteur DLNA" },
      "description": {
        "en": "What a DLNA renderer plays, its state, volume, play, pause and stop.",
        "fr": "Ce que joue un lecteur DLNA, son état, son volume, lecture, pause et stop."
      },
      "icon": "music",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Renderer", "fr": "Lecteur" },
          "required": true
        }
      ],
      "action_timeout_seconds": 15
    }
  ]
}
